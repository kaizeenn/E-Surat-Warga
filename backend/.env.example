# ===== Server =====
PORT=3002
NODE_ENV=development

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=surat_warga
DB_USER=root
DB_PASS=

# ===== JWT =====
JWT_SECRET=ganti-dengan-random-string-panjang-yang-aman
JWT_EXPIRES_IN=7d

# ===== Frontend (untuk CORS) =====
# Bisa multiple origin pisahkan dengan koma
FRONTEND_URL=http://localhost:3003

# ===== File upload =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ===== Identitas RT/RW (untuk header surat) =====
RT_NOMOR=003
RW_NOMOR=005
KELURAHAN=Sukamaju
KECAMATAN=Cibinong
KOTA=Bogor
PROVINSI=Jawa Barat
